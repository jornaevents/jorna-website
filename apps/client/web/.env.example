# Copy to .env.local. All values are public (publishable) — no secrets here.

# Jorna backend. Local by default — run jorna-backend's server on :8000. To use
# shared test data instead, set the staging API (STAGING_API_BASE_URL in the
# repo's Actions variables). Never point a dev build at production.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Supabase — only needed for Google OAuth (a later phase). The anon key is publishable.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Sentry (client-side error monitoring). Blank = disabled (see web/src/lib/sentry.ts).
NEXT_PUBLIC_SENTRY_DSN=
# NEXT_PUBLIC_SENTRY_ENVIRONMENT=production   # defaults to NODE_ENV if unset

# Dark mode. Off unless "true": the site is light only, whatever the device's
# setting, and vendor Settings has no theme picker. See lib/flags.ts.
# NEXT_PUBLIC_DARK_MODE_ENABLED=true
