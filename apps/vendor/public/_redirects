# Cloudflare Pages rewrite rules. Order matters; first match wins.
#
# The root serves the app's own root route (src/app/page.tsx, which renders
# Home) rather than redirecting to it. Status 200 is a rewrite, not a redirect:
# the browser stays on jornaevents.com and gets that file's HTML.
#
# It has to be /app/index.html and not /app/home/index.html. The client router
# resolves the path it was loaded at, and with basePath "/app" a pathname of "/"
# resolves to the app's "/" route — so serving any other page's HTML here would
# hydrate into a different page than the one that arrived.
#
# The target is /app/ and not /app/index.html. Pages normalises a served path by
# stripping "/index" and ".html", so naming the file directly makes the rule
# rewrite to something that matches itself — wrangler rejects it outright
# ("Infinite loop detected"), which with no static index.html left behind would
# mean the root 404s.
#
# The app itself is unchanged and still lives under /app; links from the root
# lead there. Deep links, emailed check-in and RSVP links, Stripe return URLs
# and the Supabase auth callback all keep working untouched.
/    /app/    200

# Old vendor routes, folded into other pages (2026-09) — real redirects
# (301, not a rewrite like the rule above) so old bookmarks/links still land
# somewhere live. Both with and without the trailing slash: trailingSlash
# is on in next.config.ts, but a request can arrive either way.
#
# /my-pipeline itself was folded into /my-dashboard on 2026-09-22 (the
# sidebar redesign — see docs/DECISIONS.md), which is also why the
# /my-leads and /my-clients targets below changed from pointing at
# /my-pipeline's view tabs to /my-dashboard's and the new standalone /clients
# page respectively — and since 2026-10 both point at /leads.
/app/my-pipeline        /app/overview                   301
/app/my-pipeline/       /app/overview                   301
/app/my-leads           /app/leads                      301
/app/my-leads/          /app/leads                      301
/app/my-clients         /app/leads                      301
/app/my-clients/        /app/leads                      301
/app/my-availability    /app/vendor-profile             301
/app/my-availability/   /app/vendor-profile             301

# The Clients page was dropped in the vendor redesign (2026-10): a couple is a
# lead until they sign, then a booking. /my-dashboard?view=leads can't be
# matched here (Pages ignores the query string), so the dashboard forwards
# that one to /leads itself.
/app/clients            /app/leads                      301
/app/clients/           /app/leads                      301

# /my-dashboard became Overview in the vendor redesign's step 1 (2026-10).
# Pages keeps the query string on a redirect, so an old ?view=leads link
# arrives at /overview, which forwards it on to /leads.
/app/my-dashboard       /app/overview                   301
/app/my-dashboard/      /app/overview                   301


# The /profile account hub was removed (2026-11): sign-out is in the vendor
# sidebar, and account details, the blocked list and deleting the account are
# all on Settings now.
/app/profile            /app/settings                   301
/app/profile/           /app/settings                   301
